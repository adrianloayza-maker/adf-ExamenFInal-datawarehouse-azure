				"     format: 'query') ~> source19",
				"source1, source2 union(byName: true)~> union1",
				"union1, source3 union(byName: true)~> union2",
				"union2, source4 union(byName: true)~> union3",
				"union3, source5 union(byName: true)~> union4",
				"union4, source6 union(byName: true)~> union5",
				"union5, source7 union(byName: true)~> union6",
				"union6, source8 union(byName: true)~> union7",
				"union7, source9 union(byName: true)~> union8",
				"union8, source10 union(byName: true)~> union9",
				"union9, source11 union(byName: true)~> union10",
				"union10, source12 union(byName: true)~> union11",
				"union11, source13 union(byName: true)~> union12",
				"union12, source14 union(byName: true)~> union13",
				"union13, source15 union(byName: true)~> union14",
				"union14, source16 union(byName: true)~> union15",
				"union15, source17 union(byName: true)~> union16",
				"union16, source18 union(byName: true)~> union17",
				"union17, source19 union(byName: true)~> union18",
				"union18 derive(fecha_key =   toInteger(concat(toString(year(fecha)), lpad(toString(month(fecha)),2,'0'), lpad(toString(dayOfMonth(fecha)),2,'0'))),",
				"          anio =   year(fecha),",
				"          mes =   month(fecha),",
				"          dia =   dayOfMonth(fecha),",
				"          nombre_mes = case(       month(fecha) == 1, 'Enero',       month(fecha) == 2, 'Febrero',       month(fecha) == 3, 'Marzo',       month(fecha) == 4, 'Abril',       month(fecha) == 5, 'Mayo',       month(fecha) == 6, 'Junio',       month(fecha) == 7, 'Julio',       month(fecha) == 8, 'Agosto',       month(fecha) == 9, 'Septiembre',       month(fecha) == 10, 'Octubre',       month(fecha) == 11, 'Noviembre',       'Diciembre'   ),",
				"          trimestre = case(       month(fecha) <= 3, 1,       month(fecha) <= 6, 2,       month(fecha) <= 9, 3,       4   ),",
				"          nombre_dia =  case(       dayOfWeek(fecha) == 1, 'Domingo',       dayOfWeek(fecha) == 2, 'Lunes',       dayOfWeek(fecha) == 3, 'Martes',       dayOfWeek(fecha) == 4, 'Miercoles',       dayOfWeek(fecha) == 5, 'Jueves',       dayOfWeek(fecha) == 6, 'Viernes',       'Sabado'   ),",
				"          es_fin_semana = iif(dayOfWeek(fecha) == 1 || dayOfWeek(fecha) == 7, 1, 0)) ~> derivedColumn1",
