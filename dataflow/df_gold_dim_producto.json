{
	"name": "df_gold_dim_producto",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_sup_catalogo_paquetes",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "silver_spl_entregas_supermercado",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_producto",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id_origen as string,",
				"          sistema_origen as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          contenido as string,",
				"          peso_kg as decimal(6,2),",
				"          costo_bs as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    paquete_id AS producto_id_origen,\\n    \\'SUP_PAQUETE\\' AS sistema_origen,\\n    nombre,\\n    CASE\\n        WHEN nombre LIKE \\'%Prenatal%\\' THEN \\'Paquete Prenatal\\'\\n        WHEN nombre LIKE \\'%Lactancia%\\' THEN \\'Paquete Lactancia\\'\\n        ELSE \\'Otro\\'\\n    END AS categoria,\\n    contenido,\\n    peso_estandar_kg AS peso_kg,\\n    costo_estimado_bs AS costo_bs\\nFROM silver.sup_catalogo_paquetes',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          producto_id_origen as string,",
				"          sistema_origen as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          contenido as string,",
				"          peso_kg as decimal(10,2),",
				"          costo_bs as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    CAST(NULL AS VARCHAR(50)) AS producto_id_origen,\\n    \\'SPL_CARNE\\' AS sistema_origen,\\n    tipo_carne AS nombre,\\n    \\'Producto Carnico\\' AS categoria,\\n    CAST(NULL AS VARCHAR(500)) AS contenido,\\n    CAST(NULL AS DECIMAL(10,2)) AS peso_kg,\\n    CAST(NULL AS DECIMAL(18,2)) AS costo_bs\\nFROM silver.spl_entregas_supermercado\\nWHERE tipo_carne IS NOT NULL AND tipo_carne <> \\'\\'',",
				"     format: 'query') ~> source2",
				"source1, source2 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_key as integer,",
				"          producto_id_origen as string,",
				"          sistema_origen as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          contenido as string,",
				"          peso_kg as decimal(10,2),",
				"          costo_bs as decimal(18,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id_origen,",
				"          sistema_origen,",
				"          nombre,",
				"          categoria,",
				"          contenido,",
				"          peso_kg,",
				"          costo_bs",
				"     )) ~> sink1"
			]
		}
	}
}