			"scriptLines": [
				"source(output(",
				"          ci as string,",
				"          establecimiento_id as string,",
				"          paquete_id as string,",
				"          nro_lote as string,",
				"          fecha_emision as date,",
				"          fecha_entrega as date,",
				"          fecha_proxima_entrega as date,",
				"          nro_boleta as string,",
				"          estado_boleta as string,",
				"          peso_paquete_kg as decimal(6,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n  UPPER(TRIM(e.ci_beneficiaria)) AS ci,\\n  UPPER(TRIM(e.establecimiento_id)) AS establecimiento_id,\\n  UPPER(TRIM(e.paquete_id)) AS paquete_id,\\n  UPPER(TRIM(e.lote_produccion)) AS nro_lote,\\n  b.fecha_emision,\\n  e.fecha_entrega,\\n  e.fecha_proxima_entrega,\\n  b.nro_boleta,\\n  b.estado AS estado_boleta,\\n  e.peso_paquete_kg\\nFROM silver.sup_entregas e\\nINNER JOIN silver.sup_boletas b\\n  ON e.boleta_id = b.boleta_id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          persona_key as integer,",
				"          ci as string,",
				"          nombres as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          nombre_completo as string,",
				"          fecha_nacimiento as date,",
				"          genero as string,",
				"          estado_civil as string,",
				"          numero_hijos as integer,",
				"          municipio_residencia as string,",
				"          en_segip as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          establecimiento_key as integer,",
				"          establecimiento_id_origen as string,",
				"          sistema_origen as string,",
				"          nombre as string,",
				"          tipo as string,",
				"          nivel_atencion as string,",
				"          municipio as string,",
				"          departamento as string,",
				"          red_salud as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM gold.dim_establecimiento WHERE sistema_origen = \\'SUP\\'',",
				"     format: 'query') ~> source3",
				"source(output(",
				"          producto_key as integer,",
				"          producto_id_origen as string,",
				"          sistema_origen as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          contenido as string,",
				"          peso_kg as decimal(10,2),",
				"          costo_bs as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM gold.dim_producto WHERE sistema_origen = \\'SUP_PAQUETE\\'',",
				"     format: 'query') ~> source4",
				"source(output(",
				"          lote_key as integer,",
				"          nro_lote as string,",
				"          proveedor as string,",
				"          anio_lote as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          anio as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          nombre_dia as string,",
				"          es_fin_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source6",
				"source1, source2 lookup(source1@ci == source2@ci,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1, source3 lookup(establecimiento_id == establecimiento_id_origen,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, source4 lookup(paquete_id == producto_id_origen,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3, source5 lookup(source1@nro_lote == source5@nro_lote,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4 derive(fecha_emision_key_busqueda = toInteger(toString(fecha_emision, 'yyyyMMdd')),",
				"          fecha_entrega_key_busqueda = toInteger(toString(fecha_entrega, 'yyyyMMdd')),",
				"          fecha_proxima_key_busqueda = toInteger(toString(fecha_proxima_entrega, 'yyyyMMdd'))) ~> derivedColumn1",
				"derivedColumn1, source6 lookup(fecha_emision_key_busqueda == fecha_key,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup5",
				"selectFechaEmision, source6 lookup(fecha_entrega_key_busqueda == fecha_key,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup6",
				"selectFechaEntrega, source6 lookup(fecha_proxima_key_busqueda == fecha_key,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup7",
				"lookup5 select(mapColumn(",
				"          ci = source1@ci,",
				"          establecimiento_id,",
				"          paquete_id,",
				"          nro_lote = source1@nro_lote,",
				"          fecha_emision,",
				"          fecha_entrega,",
				"          fecha_proxima_entrega,",
				"          nro_boleta,",
				"          estado_boleta,",
				"          peso_paquete_kg,",
				"          persona_key,",
				"          ci = source2@ci,",
				"          nombres,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          nombre_completo,",
				"          fecha_nacimiento,",
				"          genero,",
				"          estado_civil,",
				"          numero_hijos,",
				"          municipio_residencia,",
				"          en_segip,",
