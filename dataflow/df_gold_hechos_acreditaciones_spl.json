{
	"name": "df_gold_hechos_acreditaciones_spl",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_spl_asignaciones_mensuales",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_persona",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_hechos_acreditaciones_spl",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ci as string,",
				"          mes as integer,",
				"          gestion as integer,",
				"          monto_bs as decimal(18,2),",
				"          monto_productos as decimal(18,2),",
				"          monto_carnes as decimal(18,2),",
				"          estado as string,",
				"          tipo_subsidio as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n  UPPER(TRIM(af.ci_beneficiaria)) AS ci,\\n  am.mes,\\n  am.gestion,\\n  am.monto_bs,\\n  am.monto_productos,\\n  am.monto_carnes,\\n  am.estado,\\n  af.tipo_subsidio\\nFROM silver.spl_asignaciones_mensuales am\\nINNER JOIN silver.spl_afiliaciones af\\n  ON am.afiliacion_id = af.afiliacion_id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          persona_key as integer,",
				"          ci as string,",
				"          nombres as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          nombre_completo as string,",
				"          fecha_nacimiento as date,",
				"          genero as string,",
				"          estado_civil as string,",
				"          numero_hijos as integer,",
				"          municipio_residencia as string,",
				"          en_segip as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1, source2 lookup(source1@ci == source2@ci,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          acreditacion_key as integer,",
				"          persona_key as integer,",
				"          mes as integer,",
				"          gestion as integer,",
				"          monto_bs as decimal(18,2),",
				"          monto_productos as decimal(18,2),",
				"          monto_carnes as decimal(18,2),",
				"          estado as string,",
				"          tipo_subsidio as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          persona_key,",
				"          mes,",
				"          gestion,",
				"          monto_bs,",
				"          monto_productos,",
				"          monto_carnes,",
				"          estado,",
				"          tipo_subsidio",
				"     )) ~> sink1"
			]
		}
	}
}