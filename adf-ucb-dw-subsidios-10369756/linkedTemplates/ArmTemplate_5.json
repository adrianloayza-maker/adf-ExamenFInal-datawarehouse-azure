							"name": "lookup3"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "lookup4"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          canal as string,",
						"          ci as string,",
						"          nro_lote as string,",
						"          tipo_carne as string,",
						"          fecha_retiro as date,",
						"          productos_detalle as string,",
						"          peso_kg as decimal(10,2),",
						"          cantidad_kg as decimal(10,2),",
						"          monto_bs as decimal(10,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n  \\'AGENCIA\\' AS canal,\\n  UPPER(TRIM(ci_beneficiaria)) AS ci,\\n  UPPER(TRIM(lote)) AS nro_lote,\\n  CAST(NULL AS VARCHAR(50)) AS tipo_carne,\\n  fecha_entrega AS fecha_retiro,\\n  productos AS productos_detalle,\\n  peso_kg,\\n  CAST(NULL AS DECIMAL(10,2)) AS cantidad_kg,\\n  CAST(NULL AS DECIMAL(10,2)) AS monto_bs\\nFROM silver.spl_entregas_agencia',",
						"     format: 'query') ~> source1",
						"source(output(",
						"          canal as string,",
						"          ci as string,",
						"          nro_lote as string,",
						"          tipo_carne as string,",
						"          fecha_retiro as date,",
						"          productos_detalle as string,",
						"          peso_kg as decimal(10,2),",
						"          cantidad_kg as decimal(10,2),",
						"          monto_bs as decimal(18,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n  \\'SUPERMERCADO\\' AS canal,\\n  UPPER(TRIM(ci_beneficiaria)) AS ci,\\n  CAST(NULL AS VARCHAR(50)) AS nro_lote,\\n  CASE\\n    WHEN UPPER(TRIM(tipo_carne)) LIKE \\'%POL%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'P_LOL\\' THEN \\'Pollo\\'\\n    WHEN UPPER(TRIM(tipo_carne)) LIKE \\'%CERD%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'%CEDO%\\' \\n         OR UPPER(TRIM(tipo_carne)) LIKE \\'%CEDR%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'%CRD%\\' \\n         OR UPPER(TRIM(tipo_carne)) LIKE \\'%CERO%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'%CREDO%\\' THEN \\'Cerdo\\'\\n    WHEN UPPER(TRIM(tipo_carne)) LIKE \\'%PESC%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'%PSCA%\\' \\n         OR UPPER(TRIM(tipo_carne)) LIKE \\'%PESA%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'%PESD%\\' THEN \\'Pescado\\'\\n    WHEN UPPER(TRIM(tipo_carne)) LIKE \\'%VAC%\\' OR UPPER(TRIM(tipo_carne)) LIKE \\'VA_\\' THEN \\'Carne de Res\\'\\n    WHEN UPPER(TRIM(tipo_carne)) = \\'CARNE DE RES\\' THEN \\'Carne de Res\\'\\n    ELSE NULL\\n  END AS tipo_carne,\\n  fecha_retiro,\\n  CAST(NULL AS VARCHAR(200)) AS productos_detalle,\\n  CAST(NULL AS DECIMAL(10,2)) AS peso_kg,\\n  cantidad_kg,\\n  monto_bs\\nFROM silver.spl_entregas_supermercado',",
						"     format: 'query') ~> source2",
						"source(output(",
						"          persona_key as integer,",
						"          ci as string,",
						"          nombres as string,",
						"          apellido_paterno as string,",
						"          apellido_materno as string,",
						"          nombre_completo as string,",
						"          fecha_nacimiento as date,",
						"          genero as string,",
						"          estado_civil as string,",
						"          numero_hijos as integer,",
						"          municipio_residencia as string,",
						"          en_segip as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source3",
						"source(output(",
						"          lote_key as integer,",
						"          nro_lote as string,",
						"          proveedor as string,",
						"          anio_lote as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source4",
						"source(output(",
						"          producto_key as integer,",
						"          producto_id_origen as string,",
						"          sistema_origen as string,",
						"          nombre as string,",
						"          categoria as string,",
						"          contenido as string,",
						"          peso_kg as decimal(10,2),",
						"          costo_bs as decimal(18,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT * FROM gold.dim_producto WHERE sistema_origen = \\'SPL_CARNE\\'',",
						"     format: 'query') ~> source5",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha as date,",
						"          anio as integer,",
						"          mes as integer,",
						"          dia as integer,",
						"          nombre_mes as string,",
						"          trimestre as integer,",
						"          nombre_dia as string,",
						"          es_fin_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source6",
						"source1, source2 union(byName: true)~> union1",
						"union1, source3 lookup(union1@ci == source3@ci,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1, source4 lookup(union1@nro_lote == source4@nro_lote,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup2",
						"lookup2, source5 lookup(tipo_carne == nombre,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup3",
						"lookup3 derive(fecha_key_busqueda = toInteger(toString(fecha_retiro, 'yyyyMMdd'))) ~> derivedColumn1",
						"derivedColumn1, source6 lookup(fecha_key_busqueda == fecha_key,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup4",
						"lookup4 select(mapColumn(",
						"          canal,",
						"          ci = union1@ci,",
						"          nro_lote = union1@nro_lote,",
						"          tipo_carne,",
						"          fecha_retiro,",
						"          productos_detalle,",
						"          peso_kg = union1@peso_kg,",
						"          cantidad_kg,",
						"          monto_bs,",
						"          persona_key,",
						"          ci = source3@ci,",
						"          nombres,",
						"          apellido_paterno,",
						"          apellido_materno,",
						"          nombre_completo,",
						"          fecha_nacimiento,",
						"          genero,",
						"          estado_civil,",
						"          numero_hijos,",
						"          municipio_residencia,",
						"          en_segip,",
						"          lote_key,",
						"          nro_lote = source4@nro_lote,",
						"          proveedor,",
						"          anio_lote,",
						"          producto_key,",
						"          producto_id_origen,",
						"          sistema_origen,",
						"          nombre,",
						"          categoria,",
						"          contenido,",
						"          peso_kg = source5@peso_kg,",
						"          costo_bs,",
						"          fecha_key_busqueda,",
						"          fecha_key,",
						"          fecha,",
						"          anio,",
						"          mes,",
						"          dia,",
						"          nombre_mes,",
						"          trimestre,",
						"          nombre_dia,",
						"          es_fin_semana",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          retiro_key as integer,",
						"          canal as string,",
						"          persona_key as integer,",
						"          establecimiento_key as integer,",
						"          producto_key as integer,",
						"          lote_key as integer,",
						"          fecha_key as integer,",
						"          productos_detalle as string,",
						"          peso_kg as decimal(10,2),",
						"          cantidad_kg as decimal(10,2),",
						"          monto_bs as decimal(18,2)",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          canal,",
						"          persona_key,",
						"          producto_key,",
						"          lote_key,",
						"          fecha_key,",
						"          productos_detalle,",
						"          peso_kg,",
						"          cantidad_kg,",
						"          monto_bs",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
