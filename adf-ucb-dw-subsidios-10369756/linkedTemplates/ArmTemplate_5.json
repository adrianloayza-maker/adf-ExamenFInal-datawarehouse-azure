					],
					"scriptLines": [
						"source(output(",
						"          nro_lote as string,",
						"          ci as string,",
						"          sistema_destino as string,",
						"          centro_destino as string,",
						"          fecha_despacho as date,",
						"          fecha_entrega as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n  UPPER(TRIM(d.nro_lote)) AS nro_lote,\\n  UPPER(TRIM(e.ci_beneficiaria)) AS ci,\\n  \\'SUP\\' AS sistema_destino,\\n  d.centro_destino,\\n  d.fecha_despacho,\\n  e.fecha_entrega\\nFROM silver.despachos d\\nINNER JOIN silver.sup_entregas e\\n  ON UPPER(TRIM(d.nro_lote)) = UPPER(TRIM(e.lote_produccion))',",
						"     format: 'query') ~> source1",
						"source(output(",
						"          nro_lote as string,",
						"          ci as string,",
						"          sistema_destino as string,",
						"          centro_destino as string,",
						"          fecha_despacho as date,",
						"          fecha_entrega as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n  UPPER(TRIM(d.nro_lote)) AS nro_lote,\\n  UPPER(TRIM(e.ci_beneficiaria)) AS ci,\\n  \\'SPL\\' AS sistema_destino,\\n  d.centro_destino,\\n  d.fecha_despacho,\\n  e.fecha_entrega\\nFROM silver.despachos d\\nINNER JOIN silver.spl_entregas_agencia e\\n  ON UPPER(TRIM(d.nro_lote)) = UPPER(TRIM(e.lote))',",
						"     format: 'query') ~> source2",
						"source(output(",
						"          lote_key as integer,",
						"          nro_lote as string,",
						"          proveedor as string,",
						"          anio_lote as integer",
