				"          establecimiento_id_origen,",
				"          sistema_origen = source3@sistema_origen,",
				"          nombre = source3@nombre,",
				"          tipo,",
				"          nivel_atencion,",
				"          municipio,",
				"          departamento,",
				"          red_salud,",
				"          estado,",
				"          producto_key,",
				"          producto_id_origen,",
				"          sistema_origen = source4@sistema_origen,",
				"          nombre = source4@nombre,",
				"          categoria,",
				"          contenido,",
				"          peso_kg,",
				"          costo_bs,",
				"          lote_key,",
				"          nro_lote = source5@nro_lote,",
				"          proveedor,",
				"          anio_lote,",
				"          fecha_emision_key_busqueda,",
				"          fecha_entrega_key_busqueda,",
				"          fecha_proxima_key_busqueda,",
				"          fecha_emision_boleta_key = fecha_key,",
				"          fecha,",
				"          anio,",
				"          mes,",
				"          dia,",
				"          nombre_mes,",
				"          trimestre,",
				"          nombre_dia,",
				"          es_fin_semana",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectFechaEmision",
				"lookup6 select(mapColumn(",
				"          ci,",
				"          establecimiento_id,",
				"          paquete_id,",
				"          nro_lote,",
				"          fecha_emision,",
				"          fecha_entrega,",
				"          fecha_proxima_entrega,",
				"          nro_boleta,",
				"          estado_boleta,",
				"          peso_paquete_kg,",
				"          persona_key,",
				"          nombres,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          nombre_completo,",
				"          fecha_nacimiento,",
				"          genero,",
				"          estado_civil,",
				"          numero_hijos,",
				"          municipio_residencia,",
				"          en_segip,",
				"          establecimiento_key,",
				"          establecimiento_id_origen,",
				"          sistema_origen,",
				"          nombre,",
				"          tipo,",
				"          nivel_atencion,",
				"          municipio,",
				"          departamento,",
				"          red_salud,",
				"          estado,",
				"          producto_key,",
				"          producto_id_origen,",
				"          categoria,",
				"          contenido,",
				"          peso_kg,",
				"          costo_bs,",
				"          lote_key,",
				"          proveedor,",
				"          anio_lote,",
				"          fecha_emision_key_busqueda,",
				"          fecha_entrega_key_busqueda,",
				"          fecha_proxima_key_busqueda,",
				"          fecha_emision_boleta_key,",
				"          fecha = selectFechaEmision@fecha,",
				"          anio = selectFechaEmision@anio,",
				"          mes = selectFechaEmision@mes,",
				"          dia = selectFechaEmision@dia,",
				"          nombre_mes = selectFechaEmision@nombre_mes,",
				"          trimestre = selectFechaEmision@trimestre,",
				"          nombre_dia = selectFechaEmision@nombre_dia,",
				"          es_fin_semana = selectFechaEmision@es_fin_semana,",
				"          fecha_entrega_key = fecha_key,",
				"          fecha = source6@fecha,",
				"          anio = source6@anio,",
				"          mes = source6@mes,",
				"          dia = source6@dia,",
				"          nombre_mes = source6@nombre_mes,",
				"          trimestre = source6@trimestre,",
				"          nombre_dia = source6@nombre_dia,",
				"          es_fin_semana = source6@es_fin_semana",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectFechaEntrega",
				"lookup7 select(mapColumn(",
				"          ci,",
				"          establecimiento_id,",
				"          paquete_id,",
				"          nro_lote,",
				"          fecha_emision,",
				"          fecha_entrega,",
				"          fecha_proxima_entrega,",
				"          nro_boleta,",
				"          estado_boleta,",
				"          peso_paquete_kg,",
				"          persona_key,",
				"          nombres,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          nombre_completo,",
				"          fecha_nacimiento,",
				"          genero,",
				"          estado_civil,",
				"          numero_hijos,",
				"          municipio_residencia,",
				"          en_segip,",
				"          establecimiento_key,",
				"          establecimiento_id_origen,",
				"          sistema_origen,",
				"          nombre,",
				"          tipo,",
				"          nivel_atencion,",
				"          municipio,",
				"          departamento,",
				"          red_salud,",
				"          estado,",
				"          producto_key,",
				"          producto_id_origen,",
				"          categoria,",
				"          contenido,",
				"          peso_kg,",
				"          costo_bs,",
				"          lote_key,",
				"          proveedor,",
				"          anio_lote,",
				"          fecha_emision_key_busqueda,",
				"          fecha_entrega_key_busqueda,",
				"          fecha_proxima_key_busqueda,",
				"          fecha_emision_boleta_key,",
				"          fecha = selectFechaEntrega@fecha,",
				"          anio = selectFechaEntrega@anio,",
				"          mes = selectFechaEntrega@mes,",
				"          dia = selectFechaEntrega@dia,",
				"          nombre_mes = selectFechaEntrega@nombre_mes,",
				"          trimestre = selectFechaEntrega@trimestre,",
				"          nombre_dia = selectFechaEntrega@nombre_dia,",
				"          es_fin_semana = selectFechaEntrega@es_fin_semana,",
				"          fecha_entrega_key,",
				"          fecha_proxima_entrega_key = fecha_key,",
				"          fecha = source6@fecha,",
				"          anio = source6@anio,",
				"          mes = source6@mes,",
				"          dia = source6@dia,",
				"          nombre_mes = source6@nombre_mes,",
				"          trimestre = source6@trimestre,",
				"          nombre_dia = source6@nombre_dia,",
				"          es_fin_semana = source6@es_fin_semana",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectFechaProxima",
				"selectFechaProxima sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_key as integer,",
				"          persona_key as integer,",
				"          establecimiento_key as integer,",
				"          producto_key as integer,",
				"          lote_key as integer,",
				"          fecha_emision_boleta_key as integer,",
				"          fecha_entrega_key as integer,",
				"          fecha_proxima_entrega_key as integer,",
				"          nro_boleta as string,",
				"          estado_boleta as string,",
				"          peso_paquete_kg as decimal(6,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          persona_key,",
				"          establecimiento_key,",
				"          producto_key,",
				"          lote_key,",
				"          fecha_emision_boleta_key,",
				"          fecha_entrega_key,",
				"          fecha_proxima_entrega_key,",
				"          nro_boleta,",
				"          estado_boleta,",
